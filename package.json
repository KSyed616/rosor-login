{
  "name": "@rosor/login",
  "version": "0.6.0",
  "description": "The relying-party half of Rosor sign-in \u2014 authentication standard v0.9, \u00a73.4, \u00a73.5, \u00a78",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:flags",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:flags": "node scripts/write-module-flags.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run clean && npm run build"
  },
  "dependencies": {
    "jose": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
